<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StillHere - Keep Your Loved Ones Close</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
    <style>
        .arthur-intro-hero {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background-image: url('/static/images/Arthur.JPG');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            position: relative;
        }
        
        .arthur-intro-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 20, 0.4);
            z-index: 1;
        }
        
        .arthur-intro-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 4rem 5%;
            max-width: 900px;
            margin: 0 auto;
            position: relative;
            z-index: 5;
        }
        
        .arthur-greeting {
            font-size: 2rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: white;
            text-shadow: 0 2px 15px rgba(0,0,0,0.8);
            animation: fadeInUp 1s ease-out;
        }
        
        .arthur-intro-content h1 {
            font-size: 4rem;
            font-weight: 800;
            margin-bottom: 1.5rem;
            color: white;
            text-shadow: 0 4px 20px rgba(0,0,0,0.8);
            animation: fadeInUp 1.2s ease-out;
        }
        
        .arthur-intro-content .intro-text {
            font-size: 1.4rem;
            color: white;
            margin-bottom: 1rem;
            text-shadow: 0 2px 10px rgba(0,0,0,0.8);
            line-height: 1.8;
            max-width: 700px;
            animation: fadeInUp 1.4s ease-out;
        }
        
        .arthur-mission {
            font-size: 1.2rem;
            color: rgba(255, 255, 255, 0.9);
            margin-bottom: 3rem;
            text-shadow: 0 2px 10px rgba(0,0,0,0.8);
            font-style: italic;
            animation: fadeInUp 1.6s ease-out;
        }
        
        .intro-actions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
            width: 100%;
            max-width: 900px;
            animation: fadeInUp 1.8s ease-out;
        }
        
        .intro-card {
            background: rgba(30, 41, 59, 0.95);
            backdrop-filter: blur(10px);
            padding: 2.5rem;
            border-radius: 20px;
            border: 2px solid rgba(99, 102, 241, 0.4);
            transition: all 0.3s;
        }
        
        .intro-card:hover {
            transform: translateY(-8px);
            border-color: var(--primary);
            box-shadow: 0 25px 50px rgba(99, 102, 241, 0.3);
        }
        
        .intro-card h3 {
            font-size: 1.8rem;
            margin-bottom: 1rem;
            color: var(--primary);
        }
        
        .intro-card p {
            font-size: 1.1rem;
            margin-bottom: 1.5rem;
            color: var(--text-light);
        }
        
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .scroll-hint {
            position: absolute;
            bottom: 2rem;
            left: 50%;
            transform: translateX(-50%);
            color: white;
            font-size: 0.9rem;
            text-shadow: 0 2px 10px rgba(0,0,0,0.8);
            animation: bounce 2s infinite;
        }
        
        @keyframes bounce {
            0%, 100% { transform: translateX(-50%) translateY(0); }
            50% { transform: translateX(-50%) translateY(-10px); }
        }
    </style>
</head>
<body>
    <!-- Arthur Introduction Hero -->
    <header class="arthur-intro-hero">
        <nav class="nav">
            <div class="logo">StillHere</div>
            <div class="nav-links">
                <a href="#pricing">Pricing</a>
                <a href="{{ url_for('about') }}">About</a>
                <a href="{{ url_for('dashboard') }}">Dashboard</a>
            </div>
        </nav>

        <div class="arthur-intro-content">
            <p class="arthur-greeting">Hello, I'm Arthur</p>
            <h1>Your AI Guide</h1>
            <p class="intro-text">
                I'm here to help you keep your loved ones close, forever. Whether you want to see them move again, 
                hear their voice, or even talk with them - I'll guide you through every step.
            </p>
            <p class="arthur-mission">
                Creating a memorial shouldn't be hard. Let me do the work for you.
            </p>
            
            <div class="intro-actions">
                <div class="intro-card">
                    <h3>✨ Let Me Help You</h3>
                    <p>Tell me about your loved one. I'll create something beautiful for you.</p>
                    <a href="{{ url_for('create', tier='free') }}" class="cta-button primary">Start Free</a>
                </div>
                
                <div class="intro-card">
                    <h3>💜 See What's Possible</h3>
                    <p>Explore the different ways to keep your loved ones close.</p>
                    <a href="#pricing" class="cta-button secondary">View Options</a>
                </div>
            </div>
        </div>
        
        <div class="scroll-hint">Scroll to learn more ↓</div>
    </header>

    <!-- How It Works -->
    <section class="how-it-works">
        <h2>How Arthur Helps</h2>
        <div class="steps">
            <div class="step">
                <div class="step-number">1</div>
                <h3>You Share</h3>
                <p>Tell me about your loved one. Upload photos. Share memories.</p>
            </div>
            <div class="step">
                <div class="step-number">2</div>
                <h3>I Create</h3>
                <p>I'll handle all the technical stuff - animations, voice, restoration.</p>
            </div>
            <div class="step">
                <div class="step-number">3</div>
                <h3>They Live On</h3>
                <p>Watch them move, hear them speak, or talk with them anytime.</p>
            </div>
        </div>
    </section>

    <!-- Pricing Section -->
    <section id="pricing" class="pricing">
        <h2>Choose Your Memorial</h2>
        <p class="pricing-subtitle">From simple memories to eternal companionship</p>

        <div class="pricing-grid">
            {% for tier_id, tier in tiers.items() %}
            <div class="pricing-card {% if tier_id == 'eternal' %}featured{% endif %}">
                {% if tier_id == 'eternal' %}
                <div class="badge">Most Meaningful</div>
                {% endif %}

                <h3>{{ tier.name }}</h3>
                <div class="price">{{ tier.price_display }}</div>
                <p class="tier-description">{{ tier.description }}</p>

                <ul class="features">
                    {% for feature in tier.features %}
                    <li>✓ {{ feature }}</li>
                    {% endfor %}
                </ul>

                <a href="{{ url_for('create', tier=tier_id) }}" class="cta-button {% if tier_id == 'eternal' %}primary{% else %}secondary{% endif %}">
                    {{ tier.cta }}
                </a>
            </div>
            {% endfor %}
        </div>
    </section>

    <!-- Testimonials -->
    <section class="testimonials">
        <h2>Stories of Love</h2>
        <div class="testimonial-grid">
            <div class="testimonial">
                <p class="quote">"I can hear my grandmother's voice again. It's like she never left."</p>
                <p class="author">— Sarah M.</p>
            </div>
            <div class="testimonial">
                <p class="quote">"My kids talk to their grandpa every night. It's healing for all of us."</p>
                <p class="author">— Michael R.</p>
            </div>
            <div class="testimonial">
                <p class="quote">"The most beautiful gift I've ever given my mother - seeing her husband move and smile again."</p>
                <p class="author">— Jennifer K.</p>
            </div>
        </div>
    </section>

    <!-- Mission -->
    <section class="mission">
        <h2>Built With Love</h2>
        <p>StillHere was created by The Christman AI Project - a mission to bring Carbon and Silicon together in unity, not fear.</p>
        <p>We believe technology should help us remember, connect, and heal. Your loved ones deserve to be remembered. You deserve to keep them close.</p>
        <p class="css-tagline">Carbon & Silicon in Symbiotic Soul</p>
    </section>

    <!-- Footer -->
    <footer>
        <div class="footer-content">
            <div class="footer-section">
                <h4>StillHere</h4>
                <p>Keep your loved ones close. Forever.</p>
            </div>
            <div class="footer-section">
                <h4>Product</h4>
                <a href="#pricing">Pricing</a>
                <a href="{{ url_for('about') }}">About</a>
                <a href="/docs">Documentation</a>
            </div>
            <div class="footer-section">
                <h4>Support</h4>
                <a href="/contact">Contact</a>
                <a href="/privacy">Privacy</a>
                <a href="/terms">Terms</a>
            </div>
            <div class="footer-section">
                <h4>The Christman AI Project</h4>
                <p>Teaching the CSS Age</p>
                <p>Everett & Misty Christman</p>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2025 StillHere. Built with love and respect for those who deserve to be remembered.</p>
        </div>
    </footer>

    <!-- Arthur Intelligent Chat Interface -->
    <button id="start-arthur-chat">💜 Talk to Arthur</button>

    <div id="arthur-chat-container">
        <div id="arthur-chat-header">
            <h3>Arthur - Your AI Guide</h3>
            <p>I adapt to you in real-time</p>
            <div id="personality-indicator"></div>
        </div>
        <div id="arthur-chat-messages"></div>
        <div id="arthur-chat-input-container">
            <textarea id="arthur-chat-input" placeholder="Type your message..." rows="2"></textarea>
            <button id="send-arthur-message">Send</button>
        </div>
    </div>

    <script src="{{ url_for('static', filename='js/arthur_chat.js') }}"></script>
    <script src="{{ url_for('static', filename='js/arthur_voice.js') }}"></script>

    <script src="{{ url_for('static', filename='js/main.js') }}"></script>
</body>
</html>
